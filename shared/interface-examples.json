{
  "profileManifest": "{\n  \"version\": 2,\n  \"profiles\": [ … ]\n}",
  "dockerOptions": "{\n  \"shmSizeMb\": 512,\n  \"command\": [\"--flag\"]\n}",
  "agentStart": "tar -xzf {filename}\nchmod 600 .env.agent\ndocker compose --env-file .env.agent -p rdf-agent -f compose.agent.yaml up --build -d",
  "logLevels": {
    "debug": "DEBUG",
    "info": "INFO",
    "warning": "WARN",
    "error": "ERROR"
  },
  "serverLogSource": "server",
  "noProxy": "localhost,127.0.0.1,::1,example.com"
}
