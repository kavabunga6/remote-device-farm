{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Remote Device Farm device contract",
  "x-version": 1,
  "definitions": {
    "DevicePlatform": {
      "type": "string",
      "enum": [
        "android"
      ]
    },
    "DeviceKind": {
      "type": "string",
      "enum": [
        "emulator",
        "usb-android"
      ]
    },
    "PhysicalDeviceKind": {
      "type": "string",
      "enum": [
        "usb-android"
      ]
    },
    "DeviceCapability": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "touch",
        "keys",
        "rotate",
        "files",
        "install",
        "shell",
        "logs",
        "device-info",
        "env",
        "network",
        "screenshot",
        "tunnel"
      ]
    },
    "DeviceAvailability": {
      "type": "string",
      "enum": [
        "free",
        "busy",
        "cleaning",
        "unverified",
        "quarantined",
        "unauthorized",
        "offline",
        "recovery",
        "bootloader",
        "sideload"
      ]
    },
    "DeviceCapabilityReason": {
      "type": "string",
      "enum": [
        "not-supported",
        "android-version-unsupported",
        "device-probe-unavailable"
      ]
    },
    "DeviceCapabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/DeviceCapability"
      }
    },
    "DeviceCapabilityReasons": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "$ref": "#/definitions/DeviceCapabilityReason"
      }
    },
    "DeviceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "platform",
        "id",
        "model",
        "state",
        "reason"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/PhysicalDeviceKind"
        },
        "platform": {
          "$ref": "#/definitions/DevicePlatform"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "state": {
          "$ref": "#/definitions/DeviceAvailability"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "osVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "sdkLevel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        },
        "capabilities": {
          "$ref": "#/definitions/DeviceCapabilities"
        },
        "capabilityReasons": {
          "$ref": "#/definitions/DeviceCapabilityReasons"
        }
      }
    }
  }
}
