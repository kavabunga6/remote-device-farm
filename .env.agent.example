# Copy to .env.agent on each Linux host with /dev/kvm and Docker Engine 28+.
# New tokens from Nodes > Connect node need only the server address and token.
AGENT_SERVER_URL=https://farm.example.com
AGENT_TOKEN=replace-with-an-admin-issued-agent-token
AGENT_SLOTS=1
# Optional display name and address reported by the agent:
# AGENT_NAME=Lab host 1
# AGENT_HOST_IP=192.0.2.20
# Bootstrap or previously assigned credentials require their original ID:
# AGENT_ID=agent-1
# Legacy connection setting (an alternative to AGENT_SERVER_URL):
# AGENT_BROKER_URL=ws://host.docker.internal:8088/agent/connect

# Optional comma-separated prefixes for allowed ready-to-run Docker images.
# Empty allows published Google emulator images only; an explicit list also supports custom registries/local images.
AGENT_ALLOWED_IMAGE_PREFIXES=

# How emulator console commands (network profiles and geolocation) are executed:
#   auto    - through the agent-control container (docker exec inside the emulator), falling back
#             to `adb emu` only if that path is unavailable (default)
#   control - only through agent-control
#   adb     - only `adb -s <container>:5555 emu ...` (usually fails: adb allows emu only for emulator-NNNN serials)
AGENT_EMU_CONSOLE=auto
# Intel/AMD GPU: expose this render node to agent-control with compose.agent.dri.yaml.
# NVIDIA: use compose.agent.nvidia.yaml for telemetry; install NVIDIA Container Toolkit first.
# AGENT_DRI_DEVICE=/dev/dri/renderD128

# Physical Android phones over USB (off by default). A phone is leased only after a FULL wipe was verified;
# enrolled phones (the allowlist) are wiped automatically when first seen, and after every session.
# AGENT_USB_ENABLED=1
# AGENT_USB_ALLOWLIST=R58M123ABC,ZX1G22          # required: only these serials are managed (and ERASED)
# AGENT_USB_WIPE=command                         # required: full reset + verification only
#   also requires an explicit trusted reset/reprovision command; there is no safe default
#   command: your script does a FULL reset AND re-provisioning (fastboot golden image, zero-touch, Knox, ...).
#            Verified by canaries planted at lease time (settings row + files in /data and /sdcard), a new boot_id,
#            finished setup and an empty user area. A bare factory reset is not enough: it drops adb trust.
# AGENT_USB_WIPE_CMD=/opt/device-tools/reprovision-android  # mount read-only; called as `script <serial>`; full wipe and reprovision, exit 0 only when ready
# Partial cleanup is rejected, even with the former opt-in flag: accounts and system-app data survive.
# AGENT_STATE_DIR=/home/agent/.android/rdf-state # quarantine state; must be on a persistent volume

# Images need an explicit tag or digest. Missing allowed images are pulled at launch.

# Optional comparison transport; also publish this UDP range using compose.webrtc.yaml.
AGENT_WEBRTC_ENABLED=0
AGENT_WEBRTC_HOST_IP=
AGENT_WEBRTC_PORT_MIN=50000
AGENT_WEBRTC_PORT_MAX=50100
# Browser-visible STUN/TURN configuration; only use scoped TURN credentials.
AGENT_WEBRTC_ICE_SERVERS=[]

# Persistent image-build queue is mounted by Compose in agent-control.
# AGENT_IMAGE_BUILD_STATE_DIR=/var/lib/rdf-image-builds
# New images are boot/ADB validated before publication; allow room for temporary containers.
