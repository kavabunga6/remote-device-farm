# Broker: copy to .env and replace every placeholder before starting.
POSTGRES_DB=devicefarm
POSTGRES_USER=devicefarm
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
HTTP_PORT=8088
PUBLIC_URL=http://localhost:8088
# Optional second browser origin, for example on the homelab IP and dedicated port:
# FRONTEND_ORIGIN=https://192.0.2.10:8443
COOKIE_SECURE=false

# Optional direct adb connect through authenticated broker ports.
# Publish this port range on the trusted LAN/VPN only; never publish emulator 5555.
# Number of reverse proxies in front of the server (1 for the bundled nginx, 2 behind an extra gateway).
# Enables client-address based login limits; leave unset if unsure, a wrong value lets clients spoof addresses.
# TRUST_PROXY=1

# Key for encrypting profile container variables (imported or typed in the profile editor). Generate once and keep it
# apart from the database backups, for example: openssl rand -base64 32. When unset, a key is generated and stored in the database.
# SECRETS_KEY=
# New installs: scripts/init-local.mjs generates it before the first start.
# Existing encrypted data: use server/dist/migrate-secrets-key.js (see docs/deployment/server.md); changing this value alone breaks decryption.

# Seeds the built-in registry address only when none is saved. HTTPS address reachable by EVERY Docker host.
# Single Linux host quickstart uses localhost:5000 through an authenticated loopback proxy.
# RDF_BUILTIN_REGISTRY_ADDRESS=farm.example.com:8443
# Automatically pick the only online KVM node as builder if no builder was chosen.
# RDF_AUTO_IMAGE_BUILDER=true

# Fair use of slots (0 turns a limit off; administrators are never limited by the session count).
# MAX_SESSIONS_PER_USER=3
# Release a session after this many minutes without input, ADB traffic or a keep-alive. Recommended: 60.
# IDLE_TIMEOUT_MINUTES=0
# Hard limit on how long one session may live.
# MAX_SESSION_HOURS=0
# App library (APK storage per user; mounted as a volume in compose.yaml).
# APP_STORE_DIR=/data/apps
# APP_STORE_MAX_FILE_MB=200
# APP_STORE_MAX_MB_PER_USER=1024
# Install-from-URL: https only and public addresses only unless you opt in.
# APP_ALLOW_HTTP=false
# APP_ALLOW_PRIVATE=false
# ADB_PUBLIC_HOST=192.0.2.10
# ADB_PORT_START=15555
# ADB_PORT_COUNT=8

# One bootstrap agent. Create further credentials in the admin interface/API.
BOOTSTRAP_AGENT_ID=agent-1
AGENT_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# local | ldap | oidc | none
AUTH_MODE=local
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# LDAP example (used only when AUTH_MODE=ldap)
# LDAP_URL=ldaps://ldap.example.com:636
# LDAP_BASE_DN=ou=people,dc=example,dc=com
# LDAP_BIND_DN=cn=lookup,dc=example,dc=com
# LDAP_BIND_PASSWORD=replace-me
# LDAP_USER_FILTER=(uid={{username}})

# Keycloak / generic OIDC example (used only when AUTH_MODE=oidc)
# OIDC_ISSUER=https://sso.example.com/realms/devicefarm
# OIDC_CLIENT_ID=devicefarm
# OIDC_CLIENT_SECRET=replace-me
# ADMIN_SUBJECTS=oidc-subject-1,oidc-subject-2

# No-auth mode still uses a random, separate administrator token.
# ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Prometheus endpoint GET /metrics (disabled when empty). Use: Authorization: Bearer <token>, 16+ characters.
# METRICS_TOKEN=replace-with-a-random-secret
# Seconds between slot usage samples for the admin charts (0 turns it off).
# OPS_SAMPLE_SECONDS=60

# Waiting list: minutes before an unserved queue entry expires.
# QUEUE_TTL_MINUTES=30
# Webhooks: https only and no private/loopback/link-local targets unless you allow it here.
# WEBHOOK_ALLOW_HTTP=false
# WEBHOOK_ALLOW_PRIVATE=false
